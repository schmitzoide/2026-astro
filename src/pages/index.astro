---
import Base from "../layouts/Base.astro";
import { getCollection, getEntry } from "astro:content";
import { TOOL_GROUPS } from "../data/tools";
import { ALL_APPEARANCES } from "../data/appearances";
import { Image } from "astro:assets";
import { SITE } from "../lib/site";
import { decodeEntities } from "../lib/wp";
import marcelPhoto from "../assets/marcel.jpg";

// Homepage chrome is English-only (scope decision), so the writing index
// only shows EN posts. Each PT translation surfaces via the in-article
// switcher and the per-language RSS feed instead.
const posts = (
  await getCollection(
    "posts",
    ({ data }) => !data.draft && (data.language ?? "en") === "en",
  )
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const yearsBuilding = new Date().getFullYear() - 1998;

// The next event is read out of the WordPress Up Next page rather than kept in
// a second place, so the teaser can never disagree with the page it links to.
// Everything before the "Earlier this year" h3 is still upcoming; the page's
// shape is a bold date paragraph followed by an h4 naming the event. If either
// stops matching, the card is dropped rather than rendering something wrong.
const upNextPage = await getEntry("pages", "up-next");
const upcomingHtml = upNextPage?.data.contentHtml.split("<h3")[0] ?? "";
const nextDateRaw = upcomingHtml.match(/<strong>([\s\S]*?)<\/strong>/)?.[1]?.trim();
const nextDate = nextDateRaw && decodeEntities(nextDateRaw);
const nextEventRaw = upcomingHtml
  .match(/<h4[^>]*>([\s\S]*?)<\/h4>/)?.[1]
  ?.replace(/<[^>]+>/g, "")
  .split(",")[0]
  .trim();
const nextEvent = nextEventRaw && decodeEntities(nextEventRaw);
const featuredTool = TOOL_GROUPS[0].tools[0];
const toolCount = TOOL_GROUPS.flatMap((g) => g.tools).length;


const homepageSeoTitle = "Marcel Schmitz, software engineer in Porto";
const homepageDescription = `Marcel Schmitz writes on agentic development, AI security, and ${yearsBuilding}+ years of building software. Porto-based, founder of Pluginslab.`;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.url,
  jobTitle: SITE.jobTitle,
  worksFor: { "@type": "Organization", name: SITE.worksFor.name, url: SITE.worksFor.url },
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location.city,
    addressCountry: SITE.location.country,
  },
  email: `mailto:${SITE.email}`,
  sameAs: SITE.sameAs,
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: SITE.locale,
  description: homepageDescription,
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
};

const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${SITE.name}, Writing`,
  url: SITE.url,
  inLanguage: SITE.locale,
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: new URL(`/posts/${post.id}/`, SITE.url).toString(),
    datePublished: post.data.publishDate.toISOString(),
    dateModified: post.data.updatedDate.toISOString(),
    author: { "@type": "Person", name: SITE.author, url: SITE.url },
    keywords: post.data.tags.join(", "),
    articleSection: post.data.categoryName,
  })),
};

// The home page is a log: writing and appearances in one dated stream, grouped
// by year. Appearances only go back as far as the oldest post, so the log
// covers one continuous period instead of a 2017 talk dangling at the end.
type LogEntry = {
  date: Date;
  kind: "wrote" | "appeared";
  label: string;
  title: string;
  detail?: string;
  href: string;
  external: boolean;
};

const oldestPost = posts.at(-1)?.data.publishDate ?? new Date(0);
const roleLabel: Record<string, string> = {
  Speaker: "Spoke",
  Guest: "Guest",
  "Co-host": "Co-host",
};

const log: LogEntry[] = [
  ...posts.map((post) => ({
    date: post.data.publishDate,
    kind: "wrote" as const,
    label: "Wrote",
    title: post.data.title,
    detail: post.data.description,
    href: `/posts/${post.id}/`,
    external: false,
  })),
  ...ALL_APPEARANCES.map((a) => ({
    date: new Date(`${a.date}T12:00:00Z`),
    kind: "appeared" as const,
    label: roleLabel[a.role] ?? a.role,
    title: a.title,
    detail: a.venue,
    href: a.url,
    external: true,
  })).filter((a) => a.date >= oldestPost),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const logByYear = log.reduce<Map<number, LogEntry[]>>((acc, entry) => {
  const y = entry.date.getUTCFullYear();
  acc.set(y, [...(acc.get(y) ?? []), entry]);
  return acc;
}, new Map());

const dayMonth = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });

const link =
  "underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)] transition-colors";
---

<Base seoTitle={homepageSeoTitle} description={homepageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogLd)} />

  <div class="mx-auto max-w-5xl px-6 lg:px-10 pt-12 sm:pt-16 pb-8 grid gap-12 lg:gap-16 lg:grid-cols-[280px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start" aria-labelledby="hero-name">
      <Image
        src={marcelPhoto}
        alt="Marcel Schmitz"
        widths={[96, 192]}
        sizes="96px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-24 h-24 rounded-full object-cover"
      />
      <h1 id="hero-name" class="mt-5 text-[28px] leading-tight font-bold tracking-tight">Marcel Schmitz</h1>
      <p class="mt-1 text-[17px] font-medium">Software engineer in Porto</p>
      <p class="mt-4 text-[16px] text-[color:var(--fg-soft)] leading-relaxed">
        Building for the web since 1998: WordPress, WooCommerce and native iOS.
        I run <a href="https://pluginslab.com" class={link} target="_blank" rel="noopener me">Pluginslab</a>
        and make iOS apps like <a href="https://apps.apple.com/us/app/hidgets/id1533426260" class={link} target="_blank" rel="noopener">Hidgets</a>
        and <a href="https://apps.apple.com/us/app/duetcam/id1481323447" class={link} target="_blank" rel="noopener">DuetCam</a>.
      </p>
      <p class="mt-3 text-[16px] text-[color:var(--fg-soft)] leading-relaxed">
        This page is a running log of what I write and where I speak.
      </p>
      <p class="mt-3 text-base leading-none select-none" title="Brazilian, German, Portuguese">
        <span role="img" aria-label="Brazilian, German, and Portuguese heritage">🇧🇷🇩🇪🇵🇹</span>
      </p>

      <dl class="mt-6 pt-5 border-t border-[color:var(--rule)] grid gap-4 text-[15px] leading-relaxed">
        <div>
          <dt class="font-bold">Now</dt>
          <dd class="text-[color:var(--fg-soft)]">Running Pluginslab, taking selective work through Codeable, writing about agentic development.</dd>
        </div>
        {nextEvent && nextDate && (
          <div>
            <dt class="font-bold">Up next</dt>
            <dd class="text-[color:var(--fg-soft)]"><a href="/up-next/" class={link}>{nextEvent}</a>, {nextDate}</dd>
          </div>
        )}
        <div>
          <dt class="font-bold">Open source</dt>
          <dd class="text-[color:var(--fg-soft)]"><a href="/tools/" class={link}>{featuredTool.name}</a> and {toolCount - 1} more tools for WordPress and Claude Code.</dd>
        </div>
        <div>
          <dt class="font-bold">Contact</dt>
          <dd class="text-[color:var(--fg-soft)]"><a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>. I usually reply within a day.</dd>
        </div>
      </dl>
    </aside>

    <section aria-labelledby="log-heading">
      <h2 id="log-heading" class="sr-only">Writing and appearances</h2>
      {[...logByYear].map(([year, entries]) => (
        <div class="mb-10">
          <h3 class="text-[15px] font-bold text-[color:var(--fg-soft)] mb-1">{year}</h3>
          <ol class="border-t border-[color:var(--rule)]" role="list">
            {entries.map((e) => (
              <li class="grid grid-cols-[64px_minmax(0,1fr)] sm:grid-cols-[72px_84px_minmax(0,1fr)] gap-x-3 gap-y-1 items-baseline py-3.5 border-b border-[color:var(--rule)]">
                <time datetime={e.date.toISOString()} class="text-sm text-[color:var(--fg-soft)] tabular-nums">{dayMonth(e.date)}</time>
                <span class:list={[
                  "justify-self-start text-[12.5px] font-bold px-2 py-0.5 rounded",
                  e.kind === "wrote"
                    ? "text-[color:var(--wrote)] bg-[color:var(--wrote-bg)]"
                    : "text-[color:var(--appeared)] bg-[color:var(--appeared-bg)]",
                ]}>{e.label}</span>
                <div class="col-span-2 sm:col-span-1 min-w-0">
                  <a
                    href={e.href}
                    class="text-[17px] font-medium leading-snug hover:underline underline-offset-4 decoration-1"
                    target={e.external ? "_blank" : undefined}
                    rel={e.external ? "noopener" : undefined}
                  >{e.title}</a>
                  {e.detail && (
                    <p class:list={[
                      "mt-0.5 text-[15px] text-[color:var(--fg-soft)] leading-relaxed",
                      e.kind === "wrote" && "line-clamp-2",
                    ]}>{e.detail}</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <p class="text-[15px] text-[color:var(--fg-soft)]">
        Earlier talks, podcasts and press are on <a href="/appearances/" class={link}>Appearances</a>.
        Portuguese versions of every post are in the <a href="/rss-pt.xml" class={link}>Portuguese feed</a>.
      </p>
    </section>
  </div>
</Base>
