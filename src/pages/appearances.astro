---
import Base from "../layouts/Base.astro";
import { APPEARANCE_GROUPS, PRESS, ALL_APPEARANCES } from "../data/appearances";
import { SITE } from "../lib/site";

const seoTitle = "Podcasts and talks · Marcel Schmitz";
const description =
  "Every WordPress and WooCommerce podcast, interview and recorded talk Marcel Schmitz has appeared in, from WordCamp Lisboa in 2017 to co-hosting Open Makers.";

const fmt = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const fmtApprox = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });

const years = ALL_APPEARANCES.map((a) => Number(a.date.slice(0, 4)));
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Appearances by Marcel Schmitz",
  description,
  itemListElement: ALL_APPEARANCES.map((a, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: a.title,
      datePublished: a.date,
      url: a.url,
      publisher: { "@type": "Organization", name: a.venue },
      contributor: { "@type": "Person", name: SITE.author, url: SITE.url },
    },
  })),
};
---

<Base seoTitle={seoTitle} description={description} seoDescription={description}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <section class="mx-auto max-w-5xl px-6 lg:px-10 pt-16 sm:pt-24 pb-12">
    <p class="font-mono text-[12px] uppercase tracking-wider text-[color:var(--fg-soft)] mb-6">Appearances</p>
    <h1 class="font-serif text-4xl sm:text-5xl tracking-tight leading-tight font-light max-w-3xl">
      Podcasts, interviews and talks
    </h1>
    <p class="mt-8 text-lg sm:text-xl text-[color:var(--fg-soft)] leading-relaxed max-w-2xl">
      {ALL_APPEARANCES.length} of them between {firstYear} and {lastYear}: ten as
      co-host of a WooCommerce developer show, the rest as a guest or on a
      conference stage. Mostly about performance, WooCommerce at scale, and
      lately about what happens when the agent writes the code.
    </p>
  </section>

  {APPEARANCE_GROUPS.map((group) => (
    <section
      class="mx-auto max-w-5xl px-6 lg:px-10 pb-16"
      aria-labelledby={`group-${group.id}`}
    >
      <div class="border-t border-[color:var(--rule)] pt-10">
        <div class="flex flex-col sm:flex-row sm:items-start gap-6 max-w-2xl">
          {group.cover && (
            <img
              src={`/appearances/${group.cover}.jpg`}
              alt={group.coverAlt ?? ""}
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="w-24 h-24 shrink-0 rounded object-cover border border-[color:var(--rule)]"
            />
          )}
          <div>
            <h2 id={`group-${group.id}`} class="font-serif text-2xl tracking-tight">
              {group.title}
            </h2>
            <p class="mt-3 text-[15px] text-[color:var(--fg-soft)] leading-relaxed">
              {group.blurb}
            </p>
          </div>
        </div>

        <ul class="mt-10 divide-y divide-[color:var(--rule)]" role="list">
          {group.items.map((item) => (
            <li class="py-6 max-w-2xl">
              <a href={item.url} target="_blank" rel="noopener" class="group block">
                <!-- items-start matters: a flex row defaults to align-items:stretch,
                     which sets an explicit height on the thumbnail and overrides
                     its aspect-ratio, cropping the artwork. -->
                <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-5">
                  {item.image && (
                    <img
                      src={`/appearances/${item.image}.jpg`}
                      alt=""
                      width="800"
                      height="450"
                      loading="lazy"
                      decoding="async"
                      class="w-full sm:w-40 shrink-0 aspect-[16/9] rounded object-cover border border-[color:var(--rule)]"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="font-mono text-[11px] text-[color:var(--fg-soft)] tabular-nums">
                      <time datetime={item.date}>
                        {item.dateApprox ? fmtApprox(item.date) : fmt(item.date)}
                      </time>
                      {item.dateApprox && <span class="ml-1 opacity-70">(approx.)</span>}
                      <span aria-hidden="true" class="mx-1.5">·</span>
                      <span class="text-[color:var(--accent)]">{item.role}</span>
                    </p>
                    <h3 class="mt-1.5 font-serif text-lg sm:text-xl leading-snug tracking-tight group-hover:text-[color:var(--accent)] transition-colors">
                      {item.title}
                    </h3>
                    <p class="mt-1 text-[14px] text-[color:var(--fg-soft)]">
                      {item.venue}{item.withWhom && <span>, with {item.withWhom}</span>}
                    </p>
                    {item.note && (
                      <p class="mt-2 text-[14px] text-[color:var(--fg-soft)] leading-relaxed">
                        {item.note}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-6 lg:px-10 pb-16" aria-labelledby="press-heading">
    <div class="border-t border-[color:var(--rule)] pt-10 max-w-2xl">
      <h2 id="press-heading" class="font-serif text-2xl tracking-tight">Press</h2>
      <p class="mt-3 text-[15px] text-[color:var(--fg-soft)] leading-relaxed">
        Coverage rather than appearances: written about, not spoken on. Both
        concern an unofficial WordCamp app for iOS, later renamed WP Camps.
      </p>
      <ul class="mt-8 divide-y divide-[color:var(--rule)]" role="list">
        {PRESS.map((item) => (
          <li class="py-4">
            <a href={item.url} target="_blank" rel="noopener" class="group block">
              <p class="font-mono text-[11px] text-[color:var(--fg-soft)] tabular-nums">
                <time datetime={item.date}>{fmt(item.date)}</time>
                <span aria-hidden="true" class="mx-1.5">·</span>{item.venue}
              </p>
              <p class="mt-1 font-serif text-lg leading-snug group-hover:text-[color:var(--accent)] transition-colors">
                {item.title}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 lg:px-10 pb-12">
    <div class="border-t border-[color:var(--rule)] pt-10">
      <p class="text-[15px] text-[color:var(--fg-soft)] leading-relaxed max-w-2xl">
        Looking for a guest on WordPress, WooCommerce performance or agentic
        development? <a
          href={`mailto:${SITE.email}`}
          class="text-[color:var(--fg)] underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)]"
          >{SITE.email}</a
        >. Upcoming talks are on <a
          href="/up-next/"
          class="text-[color:var(--fg)] underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)]"
          >Up Next</a
        >.
      </p>
    </div>
  </section>
</Base>
