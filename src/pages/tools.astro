---
import Base from "../layouts/Base.astro";
import { TOOL_GROUPS, ALL_TOOLS } from "../data/tools";
import { fetchStars } from "../lib/github";
import { SITE } from "../lib/site";

const stars = await fetchStars();

const seoTitle = "Open-source tools · Marcel Schmitz";
const description =
  "MCP servers and an agentic harness for WordPress developers: verified hooks, validated block markup, disposable WordPress instances, and the setup I use every day.";

const escapeHtml = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

// The tool bodies are written with markdown-style backticks for inline code
// and [text](url) for links. Escape first, then promote both, so the copy
// stays readable in tools.ts without shipping raw HTML through the data file.
// Link hrefs are restricted to https:// so a stray value cannot become a
// javascript: URL.
const richText = (s: string) =>
  escapeHtml(s)
    .replace(
      /`([^`]+)`/g,
      '<code class="font-mono text-[0.9em] bg-[color:var(--bg-soft)] px-1 py-0.5 rounded">$1</code>',
    )
    .replace(
      /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener" class="text-[color:var(--fg)] underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)] transition-colors">$1</a>',
    );

const repoUrl = (repo: string) => `https://github.com/pluginslab/${repo}`;
const npmUrl = (pkg: string) => `https://www.npmjs.com/package/${pkg}`;

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Open-source tools by Marcel Schmitz",
  description,
  itemListElement: ALL_TOOLS.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareSourceCode",
      name: tool.name,
      description: tool.tagline,
      codeRepository: repoUrl(tool.repo),
      license: tool.license,
      author: { "@type": "Person", name: SITE.author, url: SITE.url },
    },
  })),
};
---

<Base seoTitle={seoTitle} description={description} seoDescription={description}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <section class="mx-auto max-w-5xl px-6 lg:px-10 pt-16 sm:pt-24 pb-12">
    <p class="font-mono text-[12px] uppercase tracking-wider text-[color:var(--fg-soft)] mb-6">Tools</p>
    <h1 class="font-serif text-4xl sm:text-5xl tracking-tight leading-tight font-light max-w-3xl">
      Things I built so the agent stops guessing
    </h1>
    <p class="mt-8 text-lg sm:text-xl text-[color:var(--fg-soft)] leading-relaxed max-w-2xl">
      Language models are confidently wrong about WordPress in very specific,
      repeatable ways. Every tool here exists because I hit one of those ways on
      a real project and got tired of it. All open source, all free.
    </p>
  </section>

  {TOOL_GROUPS.map((group) => (
    <section
      class="mx-auto max-w-5xl px-6 lg:px-10 pb-16"
      aria-labelledby={`group-${group.id}`}
    >
      <div class="border-t border-[color:var(--rule)] pt-10">
        <h2 id={`group-${group.id}`} class="font-serif text-2xl tracking-tight">
          {group.title}
        </h2>
        <p class="mt-3 text-[15px] text-[color:var(--fg-soft)] leading-relaxed max-w-2xl">
          {group.blurb}
        </p>

        <ul class="mt-10 divide-y divide-[color:var(--rule)]" role="list">
          {group.tools.map((tool) => {
            const count = stars.get(tool.repo);
            return (
              <li class="py-8 first:pt-0 max-w-2xl">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-mono text-[15px] tracking-tight">
                    <a
                      href={repoUrl(tool.repo)}
                      class="hover:text-[color:var(--accent)] transition-colors"
                      target="_blank"
                      rel="noopener"
                    >
                      {tool.name}
                    </a>
                  </h3>
                  <p class="font-mono text-[11px] text-[color:var(--fg-soft)] tabular-nums">
                    {count !== undefined && (
                      <span>
                        <span aria-hidden="true">★</span>
                        <span class="sr-only">GitHub stars:</span> {count}
                        <span aria-hidden="true" class="mx-1.5">·</span>
                      </span>
                    )}
                    {tool.license}
                  </p>
                </div>

                <p class="mt-2 font-serif text-xl sm:text-2xl leading-snug tracking-tight">
                  {tool.tagline}
                </p>

                <p
                  class="mt-3 text-[15px] text-[color:var(--fg-soft)] leading-relaxed"
                  set:html={richText(tool.body)}
                />

                {tool.install && (
                  <div class="mt-5 overflow-x-auto">
                    <code class="block font-mono text-[13px] bg-[color:var(--bg-soft)] border border-[color:var(--rule)] rounded px-4 py-3 whitespace-pre">
                      <span class="text-[color:var(--fg-soft)] select-none" aria-hidden="true">$ </span>{tool.install}
                    </code>
                  </div>
                )}

                <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[12px] text-[color:var(--fg-soft)]">
                  <a
                    href={repoUrl(tool.repo)}
                    class="hover:text-[color:var(--accent)] transition-colors"
                    target="_blank"
                    rel="noopener"
                  >
                    GitHub <span aria-hidden="true">↗</span>
                  </a>
                  {tool.npm && (
                    <a
                      href={npmUrl(tool.npm)}
                      class="hover:text-[color:var(--accent)] transition-colors"
                      target="_blank"
                      rel="noopener"
                    >
                      npm <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-6 lg:px-10 pb-12">
    <div class="border-t border-[color:var(--rule)] pt-10">
      <p class="text-[15px] text-[color:var(--fg-soft)] leading-relaxed max-w-2xl">
        Issues and pull requests are welcome on all of them. If one of these
        saved you an afternoon, or broke in an interesting way, I would like to
        hear about it: <a
          href={`mailto:${SITE.email}`}
          class="text-[color:var(--fg)] underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)]"
          >{SITE.email}</a
        >.
      </p>
    </div>
  </section>
</Base>
