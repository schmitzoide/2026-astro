---
import { SITE } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="mt-16 sm:mt-24 border-t border-[color:var(--rule)]">
  <div class="mx-auto max-w-5xl px-6 lg:px-10 py-10 flex flex-col sm:flex-row sm:items-start justify-between gap-6">
    <div class="max-w-md">
      <p class="font-bold">{SITE.name}</p>
      <p class="mt-1 text-[15px] text-[color:var(--fg-soft)]">
        Software engineer in Porto, Portugal, building for the web since 1998.
        Write to <a href={`mailto:${SITE.email}`} class="underline decoration-[color:var(--rule)] underline-offset-4 hover:decoration-[color:var(--accent)]">{SITE.email}</a>.
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-[color:var(--fg-soft)]" role="list">
      {SITE.social.map((s) => (
        <li>
          <a href={s.href} class="hover:text-[color:var(--fg)] transition-colors" target="_blank" rel="noopener">{s.label}</a>
        </li>
      ))}
      <li><a href="/rss.xml" class="hover:text-[color:var(--fg)] transition-colors">RSS</a></li>
    </ul>
  </div>
  <div class="mx-auto max-w-5xl px-6 lg:px-10 pb-8 text-sm text-[color:var(--fg-soft)]">
    <p>&copy; {year} {SITE.name}. Built with Astro and WordPress. No trackers, no popups, no cookies, no nonsense.</p>
  </div>
</footer>
